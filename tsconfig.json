{
	// Base options (strict module syntax, bundler resolution, JS checking, ...)
	// come from SvelteKit; see node_modules/$app/tsconfig.json.
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true
	},
	"include": [
		"src",
		"vite.config.ts",
		"drizzle.config.ts",
		"eslint.config.js",
		"prettier.config.js"
	]
}
